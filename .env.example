# 用法：cp .env.example .env 后填值。app/config.py 会自动 load_dotenv（不覆盖已有环境变量）。
# ⚠ .env 含密钥，已在 .gitignore 中，绝不入库。

# === App ===
APP_NAME=knowledge-atlas
APP_ENV=development
APP_LOG_LEVEL=INFO

# === 数据目录（留空 = 用仓库内 data/）===
# 生产/多环境可挂载外部目录
KNOWLEDGE_ATLAS_DATA_DIR=

# === LLM（OpenAI 兼容：iFans / RelayRouter）===
# 资源事实（哪家、哪个模型）在 config/providers.yml；本段只放运维参数与 Key。
LLM_BASE_URL=https://ingress.lfans.cn/v1
LLM_API_KEY=
# 模型选择（2026-10-07 在 iFans 网关逐个实测）：
#   gpt-flash ✅ 便宜且 JSON 稳定（主力）
#   gpt-plus / gpt-pro ✅ 更强（更贵）
#   kimi-pro ⚠ 只接受 temperature=1
#   qwen-flash / qwen-max ❌ 403 未购买
#   deepseek-flash / glm-* ⚠ 返回空 content（不可用）
LLM_MODEL=gpt-flash
LLM_MODEL_CHEAP=gpt-flash
LLM_TIMEOUT=90.0
LLM_MAX_RETRIES=2

# === Embedding（cosine 召回用；不自己训）===
# 留空 = 用 rag/embed.py 的确定性 stub（离线可跑，用于契约测试）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# === 判边（L4）===
# 低置信边是否直接丢弃（true=丢弃；false=写「待复核」区）
JUDGE_DROP_LOW_CONFIDENCE=true
