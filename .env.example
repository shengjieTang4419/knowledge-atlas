# 用法：cp .env.example .env 后填值。app/config.py 会自动 load_dotenv（不覆盖已有环境变量）。
# ⚠ .env 含密钥，已在 .gitignore 中，绝不入库。

# === App ===
APP_NAME=knowledge-atlas
APP_ENV=development
APP_LOG_LEVEL=INFO

# === 数据目录（留空 = 用仓库内 data/）===
# 生产/多环境可挂载外部目录
KNOWLEDGE_ATLAS_DATA_DIR=

LLM_DEFAULT_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=

# 追加家（可选；不填 base_url 或 key 就不进池，对运行零影响）
# 写法：LLM_PROVIDER_<ID>_BASE_URL / LLM_PROVIDER_<ID>_API_KEY
LLM_PROVIDER_RELAY_BASE_URL=
LLM_PROVIDER_RELAY_API_KEY=

LLM_CHAIN_MAIN=gpt-plus,glm-flash,gpt-pro
LLM_CHAIN_CHEAP=qwen-flash,glm-flash

# 单次尝试超时（秒）。一次调用的最坏耗时 ≈ 本项 × LLM_MAX_ATTEMPTS
LLM_TIMEOUT=60
# 一次调用最多试几个资源（有界降级）
LLM_MAX_ATTEMPTS=3

# === Embedding（cosine 召回用；不自己训）===
# 留空 = 用 rag/embed.py 的确定性 stub（离线可跑，用于契约测试）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# === 判边（L4）===
# 低置信边是否直接丢弃（true=丢弃；false=写「待复核」区）
JUDGE_DROP_LOW_CONFIDENCE=true
