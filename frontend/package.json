{
  "name": "knowledge-atlas-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "knowledge-atlas 桌面端（Electron 薄壳 + Vue3）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-run.mjs dev",
    "build": "node scripts/electron-run.mjs build",
    "preview": "node scripts/electron-run.mjs preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "marked": "^18.1.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@11.22.0"
}
